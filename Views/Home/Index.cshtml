@{
    ViewData["Title"] = "Home Page";
}
<header>
    <nav>
        <ul>
            <li><a href="">Pagina principal</a></li>
            <li><a class="Activo" href="">Usuario</a></li>
            <li><a href="">Cartelera</a></li>
            <li><a href="">Promociones</a></li>
            <li><a href="">Sedes</a></li>
            <li><a href="">Sobre nosotros</a></li>
        </ul>
    </nav>
</header>
<main>
<form action='@Url.Action("RegistrarUsuario", "Home")' method="post">
    <br>
    Nombre de usuario:<input type="text" name="nombreUsuario" id="inputNombreUsuario">
    <br>
    Nombre:<input type="text" name="nombre" id="inputNombre">
    <br>
    Apellido:<input type="text" name="apellido" id="inputApellido">
    <br>
    Contraseña:<input type="password" name="contraseña" id="inputContraseña">
    <br>
    Tipo de usuario: <select name="tipoUsuario" id="inputTipoUsuario">
        <option value="Alumno">Alumno</option>
        <option value="Docente">Docente</option>
        <option value="Coordinador">Coordinador</option>
        <option value="Padre">Padre</option>
    </select>
    <br>
    <input type="submit" value="Guardar">
</form>
</main>
<footer class="bg-dark text-white mt-5 py-4">
    <div class="container text-center">
        <p>&copy; 2026 Cine Sisro. Todos los derechos reservados.</p>
        <p class="mb-0"><small>Contacto: info@cine.com | Tel: +34 912 345 678</small></p>
    </div>
</footer>
