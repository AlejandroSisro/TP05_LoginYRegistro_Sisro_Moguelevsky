@{
    ViewData["Title"] = "Home Page";
}

<form action='@Url.Action("RegistrarUsuario", "Home")' method="post">
    <br>
    <input type="text" name="nombreUsuario" id="inputNombreUsuario" value="Ingresa tu nombre de usuario">
    <br>
    <input type="text" name="nombre" id="inputNombre" value="Ingresa tu nombre">
    <br>
    <input type="text" name="apellido" id="inputApellido" value="Ingresa tu apellido">
    <br>
    <input type="text" name="contraseña" id="inputContraseña" value="Ingresa tu contraseña">
    <br>
    <input type="text" name="tipoUsuario" id="inputTipoUsuario" value="Ingresa que tipo de usuario eres">
    <br>
    <input type="submit" value="Guardar">
</form>
