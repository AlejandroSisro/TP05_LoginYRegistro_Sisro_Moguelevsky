@{
    ViewBag.Title = "Bienvenida";
}
<header>
    <nav>
        <ul>
            <li><a href="">Pagina principal</a></li>
            <li><a href="">Usuario</a></li>
            <li><a class="Activo" href="">Cartelera</a></li>
            <li><a href="">Promociones</a></li>
            <li><a href="">Sedes</a></li>
            <li><a href="">Sobre nosotros</a></li>
        </ul>
    </nav>
</header>
<main>
<div class="container py-3">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            @if (ViewBag.nombreUsuario != null && ViewBag.nombreUsuario != "")
            {
                <div class="alert alert-info mb-4">
                    <h1 class="mb-3">¡Bienvenido @ViewBag.nombre!</h1>
                    <div>
                        <p><strong>Nombre de Usuario:</strong> @ViewBag.nombreUsuario</p>
                        <p><strong>Nombre:</strong> @ViewBag.nombre</p>
                        <p><strong>Apellido:</strong> @ViewBag.apellido</p>
                        <p><strong>Contraseña:</strong> @ViewBag.contraseña</p>
                        <p><strong>Tipo de Usuario:</strong> @ViewBag.tipoUsuario</p>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning mb-4">
                    No hay datos guardados en sesión. Por favor <a href='@Url.Action("Index")'> completa el formulario</a>.
                </div>
            }

            <div class="mb-4">
                <a href="@Url.Action("CerrarSesion", "Home")" class="btn btn-danger">Cerrar Sesión</a>
            </div>

            <h2 class="mb-4">Cartelera</h2>
    <section class="layout">
        <div>
            <img src="/images/Obsession.jpeg" alt="Poster de Obsession">
            <h3>Obsession</h3>
        </div>
        <div>
            <img src="/images/TheEndOfOakStreet.jpg" alt="Poster de The End of Oak Street">
            <h3>The End of Oak Street</h3>
        </div>
        <div>
            <img src="/images/TheOdyssey.jpg" alt="Poster de The Odyssey">
            <h3>The Odyssey</h3>
        </div>
        <div>
            <img src="/images/TheInvite.jpg" alt="Poster de The Invite">
            <h3>The Invite</h3>
        </div>
        <div>
            <img src="/images/SpiderManBrandNewDay.jpg" alt="Poster de Spider-Man: Brand New Day">
            <h3>Spider-Man: Brand New Day</h3>
        </div>
        <div>
            <img src="/images/Pressure.jpeg" alt="Poster de Pressure">
            <h3>Pressure</h3>
        </div>
        <div>
            <img src="/images/Minions&Monsters.jpg" alt="Poster de Minions & Monsters">
            <h3>Minions & Monsters</h3>
        </div>
    </section>
</main>
<footer class="bg-dark text-white mt-5 py-4">
    <div class="container text-center">
        <p>&copy; 2026 Cine Sisro. Todos los derechos reservados.</p>
        <p class="mb-0"><small>Contacto: info@cine.com | Tel: +34 912 345 678</small></p>
    </div>
</footer>
