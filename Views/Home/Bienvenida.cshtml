@{
    ViewData["Title"] = "Bienvenida";
}
<header>
    <nav>
        <ul>
            <li><a href="">Cartelera</a></li>
            <li><a class="Activo" href="">Promociones</a></li>
            <li><a href="">Sedes</a></li>
            <li><a href="">Sobre nosotros</a></li>
        </ul>
    </nav>
</header>
<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1>¡Bienvenido @ViewData["nombre"]!</h1>
            <hr>
            <div class="alert alert-info">
                <h3>Datos registrados:</h3>
                
                @if (!string.IsNullOrEmpty((string?)ViewData["nombreUsuario"]))
                {
                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <strong>Nombre de Usuario:</strong>
                        </div>
                        <div class="col-sm-8">
                            @ViewData["nombreUsuario"]
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <strong>Nombre:</strong>
                        </div>
                        <div class="col-sm-8">
                            @ViewData["nombre"]
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <strong>Apellido:</strong>
                        </div>
                        <div class="col-sm-8">
                            @ViewData["apellido"]
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <strong>Tipo de Usuario:</strong>
                        </div>
                        <div class="col-sm-8">
                            @ViewData["tipoUsuario"]
                        </div>
                    </div>

                    <hr>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        Volver al Formulario
                    </a>
                }
                else
                {
                    <div class="alert alert-warning">
                        No hay datos guardados en sesión. Por favor <a href="@Url.Action("Index")">completa el formulario</a>.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<main>
    <h2>Cartelera</h2>
    <section class="layout">
        <div>
            <img src="/images/Obsession.jpg" alt="Poster de Obsession">
            <h3>Obsession</h3>
        </div>
        <div>
            <img src="/images/TheEndOfOakStreet.jpg" alt="Poster de The End of Oak Street">
            <h3>The End of Oak Street</h3>
        </div>
        <div>
            <img src="/images/TheOdyssey.jpg" alt="Poster de The Odyssey">
            <h3>The Odyssey</h3>
        </div>
        <div>
            <img src="/images/TheInvite.jpg" alt="Poster de The Invite">
            <h3>The Invite</h3>
        </div>
        <div>
            <img src="/images/SpiderManBrandNewDay.jpg" alt="Poster de Spider-Man: Brand New Day">
            <h3>Spider-Man: Brand New Day</h3>
        </div>
        <div>6</div>
        <div>7</div>
        <div>8</div>
        <div>9</div>
    </section>
</main>
